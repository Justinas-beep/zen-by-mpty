<?xml version="1.0"?>
<ruleset name="Zen by MPTY">
	<description>WordPress coding standards for Zen source code.</description>
	<file>zen-by-mpty.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>scripts</file>
	<file>tests/integration</file>
	<arg name="extensions" value="php" />
	<arg value="sp" />
	<rule ref="WordPress" />
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="zen-by-mpty" />
			</property>
		</properties>
	</rule>
	<exclude-pattern>vendor/*</exclude-pattern>
</ruleset>

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - zen-by-mpty.php
        - uninstall.php
        - includes
        - scripts/build-production.php
        - scripts/production-manifest.php
    scanFiles:
        - zen-by-mpty.php
    bootstrapFiles:
        - tests/php/phpstan-bootstrap.php
    excludePaths:
        analyse:
            - vendor
    treatPhpDocTypesAsCertain: false
